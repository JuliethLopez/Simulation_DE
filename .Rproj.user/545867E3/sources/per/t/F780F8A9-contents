# plot Venn Diagram
markers_joined <- list(t_test = markers_filter_azimuth_t_L1$gene, wilcox_test = markers_filter_azimuth_willcox_L1$gene, DESEQ2 = markers_filter_bulk$gene, MAST = markers_filter_mast$gene)
fig <- ggVennDiagram(markers_joined, main="a") + ggtitle("Differential expressed genes Pval_adj<0.5, LFC>1 and pct_diff>0.5")
ggsave(paste0(outdir,"/Venn_Diagram_DEGs_Pval_adj.png"), fig, dpi = 300)

