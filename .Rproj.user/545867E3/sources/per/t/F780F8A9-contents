############################################
#4. Search for DEGs between CD4T and CD8T
############################################

markers_cluster <- FindMarkers(data_norm_harmony, ident.1 = "CD4T", ident.2 = "CD8T",
                               assay= "log1p_cp10k", grouping.var = "donor_id")

markers_cluster = markers_cluster %>%
  mutate(gene = rownames(markers_cluster)) %>%
  left_join(adata_var_metadata, by= "gene") %>%
  mutate(pct_difference = markers_cluster$pct.1-markers_cluster$pct.2) %>%
  select(colnames(markers_cluster), gene, gene_symbols, pct_difference)
write.csv(markers_cluster, file = paste0(outdir,"/markers_CD4T_vs_CD8T.csv"), row.names = FALSE)
