############################################
#3. Compare the DE methods
############################################

# DEGs datasets
markers_azimuth_wilcox_L1 <- read.csv(paste0(outdir,"/markers_wilcox_azimuth_L1_l2.csv"))
markers_azimuth_t_L1 <- read.csv(paste0(outdir,"/markers_ttest_azimuth_L1_l2.csv"))
markers_bulk <- read.csv(paste0(outdir,"/markers_DESEQ_azimuth_L1_l2.csv"))
markers_mast <- read.csv(paste0(outdir,"/markers_MAST_azimuth_L1_l2.csv"))

# Associate gene symbols and calculate pct_differences.
# Here pct_differences is the percentage of cells in the grop minus
# percentage of cells in all the other groups. Is espected to see a possitive marker
# for certain cell with higher percentage to that cell group vs others.
adata_var_metadata <- read_csv("adata_var_metadata.csv")
colnames(adata_var_metadata)[1] = "gene"

markers_azimuth_wilcox_L1 = markers_azimuth_wilcox_L1 %>%
  left_join(adata_var_metadata, by= "gene") %>%
  mutate(pct_difference = markers_azimuth_wilcox_L1$pct.1-markers_azimuth_wilcox_L1$pct.2) %>%
  select(colnames(markers_azimuth_wilcox_L1), gene_symbols, pct_difference)
write.csv(markers_azimuth_wilcox_L1, file = paste0(outdir,"/markers_wilcox_azimuth_L1_l2.csv"), row.names = TRUE)

markers_azimuth_t_L1 = markers_azimuth_t_L1 %>%
  left_join(adata_var_metadata, by= "gene") %>%
  mutate(pct_difference = markers_azimuth_t_L1$pct.1-markers_azimuth_t_L1$pct.2) %>%
  select(colnames(markers_azimuth_t_L1), gene_symbols, pct_difference)
write.csv(markers_azimuth_t_L1, file = paste0(outdir,"/markers_ttest_azimuth_L1_l2.csv"), row.names = TRUE)

markers_bulk = markers_bulk %>%
  left_join(adata_var_metadata, by= "gene") %>%
  mutate(pct_difference = markers_bulk$pct.1-markers_bulk$pct.2) %>%
  select(colnames(markers_bulk), gene_symbols, pct_difference)
write.csv(markers_bulk, file = paste0(outdir,"/markers_DESEQ_azimuth_L1_l2.csv"), row.names = TRUE)

markers_mast = markers_mast %>%
  left_join(adata_var_metadata, by= "gene") %>%
  mutate(pct_difference = markers_mast$pct.1-markers_mast$pct.2) %>%
  select(colnames(markers_mast), gene_symbols, pct_difference)
write.csv(markers_mast, file = paste0(outdir,"/markers_MAST_azimuth_L1_l2.csv"), row.names = TRUE)

